# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets.

# --- Linux monitoring ---
DISK_MONITOR_PATH=/

# --- Minecraft server: Server List Ping (no auth) ---
# Used for get_server_status / get_online_players. Point these at your
# actual Paper server's game address/port.
MINECRAFT_HOST=localhost
MINECRAFT_PORT=25565

# --- Minecraft server: files ---
MINECRAFT_SERVER_DIR=./minecraft_server
MINECRAFT_LOG_PATH=./minecraft_server/logs/latest.log
MINECRAFT_PROPERTIES_PATH=./minecraft_server/server.properties

# --- Minecraft server: RCON (required for get_tps/get_mspt/get_plugins) ---
# Enable in server.properties: enable-rcon=true, rcon.port=25575, rcon.password=<same as below>
MINECRAFT_RCON_HOST=localhost
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=

# --- Database ---
DATABASE_URL=postgresql+psycopg2://mcagent:mcagent@localhost:5432/mcagent

# --- LLM ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AGENT_MAX_TOOL_ITERATIONS=8
